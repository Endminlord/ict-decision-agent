#!/usr/bin/env python3
"""MCP 协议自测：启动 stdio 服务，走一遍 initialize → tools/list → tools/call。

用法：.venv/bin/python tests/test_mcp_protocol.py
（需要先 `uv pip install -e .` 装好 mcp SDK）

手写 JSON-RPC 而不是用 SDK 客户端，是为了把「外部程序怎么跟本服务说话」这件事
测得更接近 AgentArts 沙箱的真实情形。
"""

from __future__ import annotations

import json
import os
import select
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)
BIN = os.path.join(ROOT, ".venv", "bin", "ict-track2-mcp")

PROTOCOL = "2024-11-05"


class McpClient:
    """最小 stdio JSON-RPC 客户端（换行分隔）。"""

    def __init__(self, cmd: list[str], timeout: float = 30.0):
        self.p = subprocess.Popen(
            cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, text=True, bufsize=1,
        )
        self.timeout = timeout
        self._id = 0

    def _read_msg(self) -> dict:
        deadline = time.time() + self.timeout
        buf = ""
        while time.time() < deadline:
            r, _, _ = select.select([self.p.stdout], [], [], 1.0)
            if not r:
                continue
            line = self.p.stdout.readline()
            if not line:
                raise RuntimeError(f"服务端关闭了 stdout；stderr={self.stderr()[:400]}")
            line = line.strip()
            if not line:
                continue
            buf += line
            try:
                return json.loads(buf)
            except json.JSONDecodeError:
                continue  # 可能是分片，继续拼
        raise TimeoutError(f"等待响应超时；stderr={self.stderr()[:400]}")

    def call(self, method: str, params: dict | None = None, notify: bool = False) -> dict:
        msg: dict = {"jsonrpc": "2.0", "method": method}
        if params is not None:
            msg["params"] = params
        if not notify:
            self._id += 1
            msg["id"] = self._id
        self.p.stdin.write(json.dumps(msg) + "\n")
        self.p.stdin.flush()
        if notify:
            return {}
        while True:
            resp = self._read_msg()
            if resp.get("id") == msg["id"]:
                return resp

    def call_raw(self, msg: dict) -> dict:
        """原样发一条 JSON-RPC（用来构造畸形 params 这类正常客户端发不出的请求）。"""
        self.p.stdin.write(json.dumps(msg) + "\n")
        self.p.stdin.flush()
        while True:
            resp = self._read_msg()
            if resp.get("id") == msg.get("id"):
                return resp

    def alive(self) -> bool:
        return self.p.poll() is None

    def stderr(self) -> str:
        """取服务端 stderr 的**当前**内容。

        不能用 `self.p.stderr.read()`：进程还活着时它会一直等到 EOF，把测试挂死
        （断言失败时 detail 串会无条件求值，哪怕进程健在也会踩到）。
        """
        try:
            if self.p.stderr is None:
                return ""
            out = ""
            while True:
                r, _, _ = select.select([self.p.stderr], [], [], 0)
                if not r:
                    return out
                chunk = os.read(self.p.stderr.fileno(), 4096)
                if not chunk:
                    return out
                out += chunk.decode("utf-8", "replace")
        except Exception:
            return ""

    def close(self) -> None:
        try:
            self.p.terminate()
            self.p.wait(timeout=5)
        except Exception:
            self.p.kill()


def main() -> int:
    ok = total = 0

    def check(name: str, cond: bool, detail: str = "") -> None:
        nonlocal ok, total
        total += 1
        if cond:
            ok += 1
            print(f"  ✓ {name}")
        else:
            print(f"  ✗ {name} {detail}")

    if not os.path.isfile(BIN):
        print(f"找不到 {BIN}，先跑：uv pip install --python .venv/bin/python -e .")
        return 1

    c = McpClient([BIN])
    try:
        # M1 initialize
        r = c.call("initialize", {
            "protocolVersion": PROTOCOL,
            "capabilities": {},
            "clientInfo": {"name": "selftest", "version": "0.1"},
        })
        info = r.get("result", {}).get("serverInfo", {})
        check("M1 initialize 返回 serverInfo", info.get("name") == "ict-track2-mcp",
              f"got {info}")

        c.call("notifications/initialized", {}, notify=True)

        # M2 tools/list
        r = c.call("tools/list")
        tools = r.get("result", {}).get("tools", [])
        names = sorted(t["name"] for t in tools)
        check("M2 tools/list 返回 3 个工具", len(tools) == 3, f"got {names}")
        check("M3 工具名符合预期",
              names == ["list_sources", "lookup_chunk", "verify_quote"], f"got {names}")
        check("M4 每个工具都有 inputSchema",
              all("inputSchema" in t for t in tools))

        # M5 lookup_chunk 命中
        r = c.call("tools/call", {"name": "lookup_chunk",
                                  "arguments": {"chunk_id": "be1e65625142f499-0003"}})
        text = r.get("result", {}).get("content", [{}])[0].get("text", "")
        payload = json.loads(text)
        check("M5 lookup_chunk 命中真实 chunk_id", payload.get("found") is True,
              f"got {payload.get('message') or payload}")
        check("M6 返回带标题与来源",
              bool(payload.get("title")) and bool(payload.get("source")),
              f"got title={payload.get('title')!r}")

        # M7 lookup_chunk 未命中
        r = c.call("tools/call", {"name": "lookup_chunk",
                                  "arguments": {"chunk_id": "does-not-exist-0001"}})
        payload = json.loads(r.get("result", {}).get("content", [{}])[0].get("text", ""))
        check("M7 未命中返回 found=false", payload.get("found") is False)

        # M8 verify_quote 能验证真实引用
        # 用一条全量扫描下也干净的引用。原先这里用「优化营商环境」断言
        # verified=True，那其实是 B1 的产物：风险扫描只跑了前 max_hits 条，
        # 排在后面的「不利于优化营商环境」没被看见。全量扫描后它必须报风险
        # （见 M12），所以正例换成语料里没有边界否定的专名。
        r = c.call("tools/call", {"name": "verify_quote",
                                  "arguments": {"quote": "市场准入负面清单"}})
        payload = json.loads(r.get("result", {}).get("content", [{}])[0].get("text", ""))
        check("M8 verify_quote 命中真实引用",
              payload.get("verified") is True and payload.get("hit_count", 0) > 0,
              f"got {payload.get('message')}")

        # M12 B1：风险扫描与返回列表解耦 —— 同一引用、同一语料，换 max_hits
        # 不得改判。修复前 max_hits=10 → verified=True/risk=[]，
        # max_hits=500 → verified=False/risk=['omitted_negation']。
        seen = []
        for mh in (10, 500):
            r = c.call("tools/call", {"name": "verify_quote",
                                      "arguments": {"quote": "优化营商环境",
                                                    "max_hits": mh}})
            p = json.loads(r.get("result", {}).get("content", [{}])[0].get("text", ""))
            seen.append((p.get("verified"), tuple(p.get("risk_flags") or ()),
                         p.get("hit_count"), p.get("returned_hits")))
        check("M12 max_hits 不改变 verified / risk_flags",
              seen[0][:3] == seen[1][:3] and "omitted_negation" in seen[0][1],
              f"got max_hits=10 → {seen[0]}, max_hits=500 → {seen[1]}")
        check("M13 max_hits 只控制返回条数",
              seen[0][3] == 10 and seen[1][3] == 500,
              f"got returned_hits {seen[0][3]} / {seen[1][3]}")

        # M9 verify_quote 拒绝编造引用
        r = c.call("tools/call", {"name": "verify_quote",
                                  "arguments": {"quote": "这段话在语料里绝对不存在xyz123"}})
        payload = json.loads(r.get("result", {}).get("content", [{}])[0].get("text", ""))
        check("M9 verify_quote 拒绝编造引用",
              payload.get("verified") is False and payload.get("hit_count") == 0)

        # M10 list_sources
        r = c.call("tools/call", {"name": "list_sources",
                                  "arguments": {"topic": "营商环境", "top": 3}})
        payload = json.loads(r.get("result", {}).get("content", [{}])[0].get("text", ""))
        check("M10 list_sources 返回统计",
              payload.get("matched_chunks", 0) > 0 and "by_source" in payload,
              f"got {payload.get('matched_chunks')}")

        # M11 未知工具不崩
        r = c.call("tools/call", {"name": "no_such_tool", "arguments": {}})
        payload = json.loads(r.get("result", {}).get("content", [{}])[0].get("text", ""))
        check("M11 未知工具返回结构化错误", "error" in payload, f"got {payload}")

        # M14 B2：params 不是对象时回 -32602，而不是抛 AttributeError 把进程带走。
        # 修复前：`'list' object has no attribute 'get'` → rc=1，之后所有请求丢失。
        bad = c.call_raw({"jsonrpc": "2.0", "id": 9001, "method": "tools/call",
                          "params": [1, 2]})
        err = bad.get("error") or {}
        check("M14 params 非对象回 -32602",
              err.get("code") == -32602 and "result" not in bad, f"got {bad}")
        # M15 畸形请求之后进程仍能服务
        r = c.call("tools/list")
        check("M15 畸形 params 之后进程存活",
              c.alive() and len(r.get("result", {}).get("tools", [])) == 3,
              f"alive={c.alive()} stderr={c.stderr()[:300]}")
        # M16 tools/list 与 initialize 同样校验 params
        bad2 = c.call_raw({"jsonrpc": "2.0", "id": 9002, "method": "tools/list",
                           "params": "oops"})
        check("M16 tools/list 的 params 非对象回 -32602",
              (bad2.get("error") or {}).get("code") == -32602, f"got {bad2}")
    finally:
        c.close()

    print(f"\n[test_mcp_protocol] {ok}/{total}")
    return 0 if ok == total else 1


if __name__ == "__main__":
    sys.exit(main())
